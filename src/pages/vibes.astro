---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SectionHeader from '../components/SectionHeader.astro';
import MediaCard from '../components/MediaCard.astro';
import { favoritePlaces, savedPlacesUrl } from '../data/places';
import { games, steamProfileUrl } from '../data/games';
import { animeList, animeListUrl } from '../data/anime';

const mostPlayed = [...games].sort((a, b) => b.hours - a.hours);
---

<Layout title="Vibes | Kevin">
  <Nav />

  <main>
    <section class="hero">
      <div class="container">
        <h1 class="page-title">Vibes</h1>
        <p class="page-subtitle">
          Games I play, anime I watch, and things I'm into.
        </p>
      </div>
    </section>

    <!-- Steam Games -->
    <section class="steam-section">
      <div class="container">
        <SectionHeader title="Games" subtitle="Most played games" link={steamProfileUrl} linkText="Steam profile" />

        <div class="shelf">
          {mostPlayed.map((game) => (
            <MediaCard title={game.name} meta={`${game.hours}h played`} image={game.image} link={game.link} />
          ))}
        </div>
      </div>
    </section>

    <!-- Anime List -->
    <section class="anime-section">
      <div class="container">
        <SectionHeader title="Anime" subtitle="All-time favorites" link={animeListUrl} linkText="Full list on Bilibili" />

        <div class="shelf">
          {animeList.map((anime) => (
            <MediaCard title={anime.title} image={anime.image} link={anime.link} />
          ))}
        </div>
      </div>
    </section>

    <!-- Places -->
    <section class="places-section">
      <div class="container">
        <SectionHeader title="Places" subtitle="Favorite spots" link={savedPlacesUrl} linkText="Full list on Google Maps" />

        <div class="places-grid">
          {favoritePlaces.map((place) => (
            <MediaCard title={place.name} meta={place.location} image={place.image} link={place.link} landscape />
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .hero {
    padding: 140px 0 60px;
  }

  .page-title {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    margin-bottom: 16px;
  }

  .page-subtitle {
    font-size: 1.125rem;
    color: var(--text-secondary);
    max-width: 500px;
  }

  section {
    padding: 60px 0;
  }

  .shelf {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 28px 20px;
  }

  .places-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px 20px;
  }

  @media (max-width: 768px) {
    .places-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
