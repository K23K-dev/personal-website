---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
---

<Layout title="Kevin | CS @ GT">
  <Nav />
  <main>
    <section class="hero">
      <div class="container">
        <div class="hero-content">
          <h1 class="hero-title">
            Hi, I'm <span class="highlight">Kevin</span>—<br/>
            I build things and <br/>
            <span class="italic">sometimes</span> they work.
          </h1>
          
          <p class="hero-description">
            CS student at Georgia Tech passionate about distributed systems, 
            machine learning, and crafting software that solves real problems. 
            Currently exploring the intersection of AI and systems programming.
          </p>
          
          <div class="hero-actions">
            <a href="/projects" class="btn btn-primary">See my work</a>
            <a href="#about" class="btn btn-secondary">More about me</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 120px 0 80px;
  }

  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: 24px;
  }

  .hero-title .highlight {
    color: var(--accent-primary);
  }

  .hero-title .italic {
    font-style: italic;
  }

  .hero-description {
    font-size: 1.125rem;
    color: var(--text-secondary);
    max-width: 480px;
    margin-bottom: 32px;
  }

  .hero-actions {
    display: flex;
    gap: 16px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: 100px;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .btn-primary {
    background: var(--accent-primary);
    color: var(--bg-primary);
  }

  .btn-secondary {
    border: 1px solid var(--border-color);
    color: var(--text-primary);
  }
</style>
