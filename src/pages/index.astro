---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Terminal from '../components/Terminal.astro';
import { featuredProjects } from '../data/projects';
---

<Layout title="Kevin | CS @ GT">
  <Nav />
  <main>
    <section class="hero">
      <div class="container">
        <div class="hero-content">
          <h1 class="hero-title">
            Hi, I'm <span class="highlight">Kevin</span>—<br/>
            I build things and <br/>
            <span class="italic">sometimes</span> they work.
          </h1>
          
          <p class="hero-description">
            CS student at Georgia Tech passionate about distributed systems, 
            machine learning, and crafting software that solves real problems. 
            Currently exploring the intersection of AI and systems programming.
          </p>
          
          <div class="hero-actions">
            <a href="/projects" class="btn btn-primary">See my work</a>
            <a href="#about" class="btn btn-secondary">More about me</a>
          </div>
        </div>

        <div class="hero-visual">
          <Terminal title="~/life">
            <span class="prompt">$</span> whoami<br/>
            <span class="output">kevin @ georgia-tech</span><br/><br/>
            <span class="prompt">$</span> cat interests.txt<br/>
            <span class="output">distributed systems</span><br/>
            <span class="output">machine learning</span><br/>
            <span class="output">dev tools</span><br/>
            <span class="output">good coffee</span><br/><br/>
            <span class="prompt">$</span> echo $STATUS<br/>
            <span class="output accent">building cool stuff ▊</span>
          </Terminal>
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section class="about" id="about">
      <div class="container">
        <SectionHeader title="About" />
        
        <div class="about-grid">
          <div class="about-content">
            <p class="lead">
              I'm a third-year Computer Science student at Georgia Tech, 
              pursuing threads in <strong>Systems & Architecture</strong> and <strong>Intelligence</strong>.
            </p>
            <p>
              Currently working on ML infrastructure and distributed systems. 
              Also interested in finance and fintech on the side.
            </p>
            <p>
              Taking courses in computer architecture, machine learning, and algorithms. 
              Looking to do research in systems or ML next semester.
            </p>
            
            <div class="skills">
              <h3>Tech Stack</h3>
              <div class="skill-tags">
                <span>Python</span>
                <span>Java</span>
                <span>C++</span>
                <span>TypeScript</span>
                <span>PyTorch</span>
                <span>PostgreSQL</span>
                <span>Docker</span>
                <span>AWS</span>
              </div>
            </div>
          </div>

          <div class="about-image">
            <img 
              src="https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?w=800&q=80" 
              alt="Fushimi Inari shrine in Kyoto, Japan" 
            />
            <span class="image-caption">Fushimi Inari, Kyoto</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Projects Section -->
    <section class="projects">
      <div class="container">
        <SectionHeader title="Featured Projects" link="/projects" linkText="View all" />
        
        <div class="projects-grid">
          {featuredProjects.map((project, index) => (
            <ProjectCard
              title={project.title}
              description={project.shortDescription}
              tags={project.tags}
              link={project.link || `/projects#${project.id}`}
              index={index}
            />
          ))}
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 120px 0 80px;
  }

  .hero .container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: 24px;
  }

  .hero-title .highlight {
    color: var(--accent-primary);
  }

  .hero-title .italic {
    font-style: italic;
  }

  .hero-description {
    font-size: 1.125rem;
    color: var(--text-secondary);
    max-width: 480px;
    margin-bottom: 32px;
  }

  .hero-actions {
    display: flex;
    gap: 16px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: 100px;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .btn-primary {
    background: var(--accent-primary);
    color: var(--bg-primary);
  }

  .btn-secondary {
    border: 1px solid var(--border-color);
    color: var(--text-primary);
  }

  /* Sections */
  section {
    padding: 80px 0;
  }

  .section-title {
    font-size: 2rem;
    margin-bottom: 48px;
  }

  /* About */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: 60px;
    align-items: center;
  }

  .about-content .lead {
    font-size: 1.25rem;
    color: var(--text-primary);
    margin-bottom: 20px;
    line-height: 1.6;
  }

  .about-content p {
    color: var(--text-secondary);
    margin-bottom: 16px;
    line-height: 1.7;
  }

  .about-content strong {
    color: var(--accent-primary);
    font-weight: 600;
  }

  .skills {
    margin-top: 32px;
  }

  .skills h3 {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .skill-tags span {
    padding: 6px 12px;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 100px;
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  /* Section Header */
  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 48px;
  }

  .section-link {
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .about-image {
    position: relative;
  }

  .about-image img {
    width: 100%;
    height: 320px;
    object-fit: cover;
    border-radius: 16px;
    border: 1px solid var(--border-color);
  }

  .image-caption {
    position: absolute;
    bottom: 16px;
    left: 16px;
    font-size: 0.75rem;
    color: white;
    background: rgba(0, 0, 0, 0.6);
    padding: 6px 12px;
    border-radius: 100px;
    backdrop-filter: blur(4px);
  }

  /* Projects */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  @media (max-width: 1024px) {
    .hero .container {
      grid-template-columns: 1fr;
    }
    .hero-visual {
      display: none;
    }

    .about-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
