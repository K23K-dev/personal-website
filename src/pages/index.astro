---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Kevin | CS @ GT">
  <Nav />
  <main>
    <section class="hero">
      <div class="container">
        <div class="hero-content">
          <h1 class="hero-title">
            Hi, I'm <span class="highlight">Kevin</span>—<br/>
            I build things and <br/>
            <span class="italic">sometimes</span> they work.
          </h1>
          
          <p class="hero-description">
            CS student at Georgia Tech passionate about distributed systems, 
            machine learning, and crafting software that solves real problems. 
            Currently exploring the intersection of AI and systems programming.
          </p>
          
          <div class="hero-actions">
            <a href="/projects" class="btn btn-primary">See my work</a>
            <a href="#about" class="btn btn-secondary">More about me</a>
          </div>
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section class="about" id="about">
      <div class="container">
        <h2 class="section-title">About</h2>
        
        <div class="about-grid">
          <div class="about-content">
            <p class="lead">
              I'm a third-year Computer Science student at Georgia Tech, 
              pursuing threads in <strong>Systems & Architecture</strong> and <strong>Intelligence</strong>.
            </p>
            <p>
              Currently working on ML infrastructure and distributed systems. 
              Also interested in finance and fintech on the side.
            </p>
            <p>
              Taking courses in computer architecture, machine learning, and algorithms. 
              Looking to do research in systems or ML next semester.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 120px 0 80px;
  }

  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: 24px;
  }

  .hero-title .highlight {
    color: var(--accent-primary);
  }

  .hero-title .italic {
    font-style: italic;
  }

  .hero-description {
    font-size: 1.125rem;
    color: var(--text-secondary);
    max-width: 480px;
    margin-bottom: 32px;
  }

  .hero-actions {
    display: flex;
    gap: 16px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: 100px;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .btn-primary {
    background: var(--accent-primary);
    color: var(--bg-primary);
  }

  .btn-secondary {
    border: 1px solid var(--border-color);
    color: var(--text-primary);
  }

  /* Sections */
  section {
    padding: 80px 0;
  }

  .section-title {
    font-size: 2rem;
    margin-bottom: 48px;
  }

  /* About */
  .about-grid {
    max-width: 640px;
  }

  .about-content .lead {
    font-size: 1.25rem;
    color: var(--text-primary);
    margin-bottom: 20px;
    line-height: 1.6;
  }

  .about-content p {
    color: var(--text-secondary);
    margin-bottom: 16px;
    line-height: 1.7;
  }

  .about-content strong {
    color: var(--accent-primary);
    font-weight: 600;
  }

</style>
