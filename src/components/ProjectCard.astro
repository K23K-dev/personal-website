---
import { Icon } from 'astro-icon/components';

interface Props {
  title: string;
  description: string;
  tags: string[];
  link: string;
  index: number;
}

const { title, description, tags, link, index } = Astro.props;
---

<a href={link} class="project-card">
  <div class="project-number">{String(index + 1).padStart(2, '0')}</div>
  <h3 class="project-title">{title}</h3>
  <p class="project-description">{description}</p>
  <div class="project-tags">
    {tags.map(tag => <span class="tag">{tag}</span>)}
  </div>
  <div class="project-arrow">
    <Icon name="lucide:arrow-up-right" size={24} />
  </div>
</a>

<style>
  .project-card {
    position: relative;
    display: block;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 32px;
  }

  .project-number {
    font-family: monospace;
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .project-title {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 12px;
  }

  .project-description {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    margin-bottom: 20px;
    line-height: 1.6;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag {
    padding: 4px 12px;
    background: var(--bg-secondary);
    border-radius: 100px;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .project-arrow {
    position: absolute;
    top: 24px;
    right: 24px;
    color: var(--accent-primary);
  }
</style>
