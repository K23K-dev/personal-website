---
interface Props {
  name: string;
  location: string;
  image: string;
  link: string;
}

const { name, location, image, link } = Astro.props;
---

<a href={link} target="_blank" rel="noopener" class="place-card">
  <img src={image} alt={name} class="place-image" loading="lazy" />
  <div class="place-overlay">
    <span class="place-name">{name}</span>
    <span class="place-location">{location}</span>
  </div>
</a>

<style>
  .place-card {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    display: block;
  }

  .place-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .place-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 16px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.8) 0%, transparent 100%);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .place-name {
    font-weight: 600;
    font-size: 0.9375rem;
    color: white;
  }

  .place-location {
    font-size: 0.75rem;
    color: var(--accent-primary);
    font-weight: 500;
  }
</style>
