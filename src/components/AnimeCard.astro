---
interface Props {
  title: string;
  description: string;
  image: string;
  link: string;
}

const { title, description, image, link } = Astro.props;
---

<a href={link} target="_blank" rel="noopener" class="anime-card">
  <img src={image} alt={title} class="anime-image" loading="lazy" />
  <div class="anime-info">
    <span class="anime-title">{title}</span>
    <span class="anime-description">{description}</span>
  </div>
</a>

<style>
  .anime-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
  }

  .anime-image {
    width: 80px;
    height: 110px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .anime-info {
    padding: 16px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
  }

  .anime-title {
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.3;
  }

  .anime-description {
    font-size: 0.8125rem;
    color: var(--text-muted);
    line-height: 1.4;
  }
</style>
